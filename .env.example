# =========================
# Frontend / CORS
# =========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_PLANNING_MODE=llm

# =========================
# Application
# =========================
MAX_ITER=5

# =========================
# Database
# =========================
DATABASE_URL=sqlite+aiosqlite:///./plcforge.db

# =========================
# Validation
# =========================
MATIEC_BIN=/usr/local/bin/iec2c
PLCVERIF_BIN=/usr/local/bin/plcverif
VERIFICATION_TIMEOUT_S=120

# =========================
# LLM Provider Selection
# Supported: anthropic | openai | gemini | groq | ollama
# =========================
LLM_PROVIDER=openai
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:33b

